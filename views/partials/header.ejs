<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %><%= typeof tenant !== 'undefined' && tenant ? ' · ' + tenant.name : ' · منصة الدعوات' %></title>
  <link rel="stylesheet" href="/public/css/style.css">
  <% if (typeof tenant !== 'undefined' && tenant && tenant.primary_color) { %>
    <style>:root { --primary: <%= tenant.primary_color %>; --primary-dark: <%= tenant.primary_color %>; }</style>
  <% } %>
</head>
<body>
<% if (admin) { %>
  <div class="topbar">
    <a class="brand" href="/admin" style="display:flex; align-items:center; gap:8px;">
      <% if (typeof tenant !== 'undefined' && tenant && tenant.logo_path) { %>
        <img src="<%= tenant.logo_path %>" alt="" style="height:26px; width:auto; border-radius:4px;">
      <% } %>
      <%= (typeof tenant !== 'undefined' && tenant) ? tenant.name : 'منصة الدعوات' %>
    </a>
    <div class="actions">
      <span><%= admin.username %></span>
      <form class="inline" method="POST" action="/logout">
        <button class="btn secondary small" type="submit">تسجيل الخروج</button>
      </form>
    </div>
  </div>
<% } %>
