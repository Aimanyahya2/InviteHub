<%- include('partials/header') %>
<div class="container">
  <div class="page-header">
    <h1>المناسبات</h1>
    <a class="btn" href="/admin/events/new">+ مناسبة جديدة</a>
  </div>

  <% const types = Object.keys(typeCounts); %>
  <% if (types.length > 0) { %>
    <div style="display:flex; gap:6px; flex-wrap:wrap; margin-bottom:18px;">
      <a class="pill <%= !typeFilter ? 'confirmed' : 'pending' %>" href="/admin">الكل (<%= totalCount %>)</a>
      <% types.forEach(t => { %>
        <a class="pill <%= typeFilter === t ? 'confirmed' : 'pending' %>" href="/admin?type=<%= encodeURIComponent(t) %>"><%= t %> (<%= typeCounts[t] %>)</a>
      <% }) %>
    </div>
  <% } %>

  <% if (events.length === 0) { %>
    <div class="card empty-state">
      ما فيه مناسبات <%= typeFilter ? 'من هذا النوع' : 'بعد. ابدأ بإنشاء أول مناسبة' %>.
    </div>
  <% } %>

  <% events.forEach(e => { %>
    <a class="card event-card" href="/admin/events/<%= e.id %>">
      <div>
        <div style="font-weight:700; font-size:16px;"><%= e.title %></div>
        <div class="meta">
          <% if (e.event_type) { %><span class="pill sent"><%= e.event_type %></span> · <% } %>
          <%= e.client_name || 'بدون اسم عميل' %>
          <% if (e.event_date) { %> · <%= e.event_date %> <% } %>
          · <span class="pill pending"><%= e.status %></span>
        </div>
      </div>
      <div class="stats">
        <div><b><%= e.stats.total %></b>مدعو</div>
        <div><b><%= e.stats.sent %></b>أُرسلت</div>
        <div><b><%= e.stats.confirmed %></b>تأكيد حضور</div>
      </div>
    </a>
  <% }) %>
</div>
<%- include('partials/footer') %>
