<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
  <div class="topbar">
    <a class="brand" href="/super-admin">لوحة المشرف العام</a>
    <div class="actions">
      <span><%= superAdmin.username %></span>
      <form class="inline" method="POST" action="/super-admin/logout">
        <button class="btn secondary small" type="submit">تسجيل الخروج</button>
      </form>
    </div>
  </div>

  <div class="container">
    <div class="page-header">
      <h1>المستأجرون (الموزّعون)</h1>
      <a class="btn" href="/super-admin/tenants/new">+ مستأجر جديد</a>
    </div>

    <% if (tenants.length === 0) { %>
      <div class="card empty-state">ما فيه مستأجرين بعد. أنشئ أول حساب موزّع.</div>
    <% } %>

    <% tenants.forEach(t => { %>
      <a class="card event-card" href="/super-admin/tenants/<%= t.id %>">
        <div>
          <div style="font-weight:700; font-size:16px;"><%= t.name %></div>
          <div class="meta">
            <%= t.custom_domain || (t.subdomain + '.' + 'دومين المنصة') %>
            · <span class="pill <%= t.status === 'نشط' ? 'confirmed' : 'declined' %>"><%= t.status %></span>
            · <%= t.plan %>
          </div>
        </div>
        <div class="stats">
          <div><b><%= t.counts.events %></b>مناسبة</div>
          <div><b><%= t.counts.guests %></b>مدعو</div>
        </div>
      </a>
    <% }) %>
  </div>
</body>
</html>
