<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title><%= event.title %> - باركودات المدعوين</title>
  <style>
    body { font-family: sans-serif; direction: rtl; margin: 20px; }
    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .item { border: 1px solid #ddd; border-radius: 8px; padding: 12px; text-align: center; page-break-inside: avoid; }
    .item img { width: 140px; height: 140px; }
    .item .name { font-weight: bold; margin-top: 6px; font-size: 14px; }
    .item .phone { color: #666; font-size: 12px; }
    h1 { text-align: center; }
    @media print { .no-print { display: none; } }
  </style>
</head>
<body>
  <h1><%= event.title %> - باركودات الدخول</h1>
  <div class="no-print" style="text-align:center; margin-bottom:20px;">
    <button onclick="window.print()">طباعة</button>
  </div>
  <div class="grid">
    <% guests.forEach(g => { %>
      <div class="item">
        <img src="<%= g.qrDataUrl %>" alt="باركود">
        <div class="name"><%= g.name %></div>
        <% if (g.phone) { %><div class="phone"><%= g.phone %></div><% } %>
      </div>
    <% }) %>
  </div>
</body>
</html>
