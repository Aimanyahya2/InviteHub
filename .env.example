# انسخ هذا الملف إلى .env وعدّل القيم

PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# بيانات دخول "المشرف العام" (مالك المنصة - أنت) - تُستخدم فقط عند أول تشغيل لـ npm run seed
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=change-this-password

# النطاق الرئيسي للمنصة (تستخدمه أنت كمالك، وتُبنى عليه النطاقات الفرعية الافتراضية للمستأجرين
# مثل tenant1.yourplatform.com إذا لم يربطوا دومين خاص بعد)
PLATFORM_ROOT_DOMAIN=yourplatform.com

# الدومين المخصص لدخول المشرف العام (لوحة إدارة المستأجرين) - يفضّل يكون فرعي منفصل
# مثال: manage.yourplatform.com
SUPER_ADMIN_HOST=manage.yourplatform.com

# إعدادات مزود واتساب (اختياري - للمرحلة القادمة، يمكن ضبطها لكل مستأجر لاحقًا)
# WATI_API_URL=
# WATI_API_KEY=
